  tenantId              String
  branchId              String?
  title                 String
  department            String
  designation           String
  openingsCount         Int               @default(1)
  minExperienceYears    Float             @default(0.0)
  qualificationRequired String?
  status                JobOpeningStatus  @default(OPEN)
  description           String?
  closingDate           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  applications          JobApplication[]

  @@index([tenantId, status])
  @@map("job_openings")
}

/// Recruitment applicant submissions
model JobApplication {
  id                   String               @id @default(uuid())
  tenantId             String
  jobOpeningId         String
  candidateName        String
  email                String
  phone                String
  currentLocation      String?
  highestQualification String?
  experienceYears      Float                @default(0.0)
  resumeUrl            String?
  status               JobApplicationStatus @default(APPLIED)
  notes                String?
  appliedAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOpening           JobOpening           @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  interviews           Interview[]

  @@index([tenantId, jobOpeningId])

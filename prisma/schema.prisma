}

/// Interview rounds
model Interview {
  id               String          @id @default(uuid())
  jobApplicationId String
  roundName        String
  scheduledAt      DateTime
  interviewerId    String?
  interviewerName  String?
  status           InterviewStatus @default(SCHEDULED)
  feedback         String?
  rating           Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobApplication   JobApplication  @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([jobApplicationId])
  @@map("interviews")
}

/// Resignation submission & notice tracking
model ResignationRequest {
  id              String            @id @default(uuid())
  tenantId        String
  staffProfileId  String            @unique
  resignationDate DateTime          @default(now())
  requestedLwd    DateTime          @db.Date
  agreedLwd       DateTime?         @db.Date
  reason          String
  status          ResignationStatus @default(SUBMITTED)
  actionedById    String?
  actionedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile    StaffProfile      @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("resignation_requests")
}

/// Offboarding clearance tasks (Inventory custody, Academic handover, Finance settlement, Access revocation)
model OffboardingTask {
  id             String              @id @default(uuid())
  tenantId       String
  staffProfileId String
  taskType       OffboardingTaskType
  description    String
  assignedRole   String
  isCompleted    Boolean             @default(false)
  completedById  String?
  completedByName String?
  completedAt    DateTime?
  remarks        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile        @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffProfileId])
  @@map("offboarding_tasks")
}

// =========================================================================
// TRANSPORT & FLEET MANAGEMENT (PRESCHOOL CHILD SAFETY & ROUTE OPERATIONS)
// =========================================================================

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum StopStatus {
  ACTIVE
  INACTIVE
}

enum TransportTripType {
  TWO_WAY
  MORNING_ONLY
  EVENING_ONLY
}

enum TransportAssignmentStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TripOperationalType {
  MORNING
  EVENING
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ManifestItemStatus {
  EXPECTED
  BOARDED
  ARRIVAL_SUBMITTED
  ARRIVAL_VERIFIED
  DROPPED
  ABSENT
  MISSED
}

enum TransportIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransportIncidentCategory {
  BREAKDOWN
  TRAFFIC_DELAY
  ACCIDENT
  STUDENT_ILLNESS
  UNAUTHORIZED_PICKUP
  OTHER
}

enum TransportIncidentStatus {
  REPORTED
  INVESTIGATING
  RESOLVED
}

/// School transport vehicle / bus / van
model Vehicle {
  id                 String          @id @default(uuid())
  tenantId           String
  branchId           String?
  registrationNumber String
  vehicleType        String          @default("BUS")
  capacity           Int             @default(20)
  makeModel          String?
  status             VehicleStatus   @default(ACTIVE)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?         @relation(fields: [branchId], references: [id])
  routes             TransportRoute[]
  trips              TransportTrip[]
  incidents          TransportIncident[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("transport_vehicles")
}

/// Transport route with vehicle, driver, and attendant linkage
model TransportRoute {
  id                 String          @id @default(uuid())
  tenantId           String
  branchId           String?
  code               String
  name               String
  status             RouteStatus     @default(ACTIVE)
  description        String?
  vehicleId          String?
  driverProfileId    String?
  attendantProfileId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?         @relation(fields: [branchId], references: [id])
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id])
  driverProfile      StaffProfile?   @relation("RouteDriver", fields: [driverProfileId], references: [id])
  attendantProfile   StaffProfile?   @relation("RouteAttendant", fields: [attendantProfileId], references: [id])

  stops              RouteStop[]
  assignments        StudentTransportAssignment[]
  trips              TransportTrip[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("transport_routes")
}

/// Ordered stop along a transport route
model RouteStop {
  id                 String          @id @default(uuid())
  tenantId           String
  routeId            String
  name               String
  landmark           String?
  sequence           Int
  morningPickupTime  String          @default("08:00")
  eveningDropTime    String          @default("15:00")
  status             StopStatus      @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route              TransportRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  pickupAssignments  StudentTransportAssignment[] @relation("PickupStop")
  dropAssignments    StudentTransportAssignment[] @relation("DropStop")
  manifestItems      TripManifestItem[]

  @@unique([routeId, sequence])
  @@index([tenantId, routeId])
  @@map("transport_route_stops")
}

/// Student transport assignment connecting Student to Route, Stops, and Academic Session
model StudentTransportAssignment {
  id                 String                    @id @default(uuid())
  tenantId           String
  branchId           String?
  academicSessionId  String
  studentId          String
  requestedByGuardianId String?
  routeId            String
  pickupStopId       String
  dropStopId         String
  tripType           TransportTripType         @default(TWO_WAY)
  startDate          DateTime                  @default(now()) @db.Date
  endDate            DateTime?                 @db.Date
  status             TransportAssignmentStatus @default(ACTIVE)
  monthlyFeeCents    Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                   @relation(fields: [branchId], references: [id])
  academicSession    AcademicSession           @relation(fields: [academicSessionId], references: [id])
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route              TransportRoute            @relation(fields: [routeId], references: [id])
  pickupStop         RouteStop                 @relation("PickupStop", fields: [pickupStopId], references: [id])
  dropStop           RouteStop                 @relation("DropStop", fields: [dropStopId], references: [id])

  @@index([tenantId, academicSessionId])
  @@index([tenantId, studentId])
  @@index([tenantId, routeId])
  @@index([tenantId, status])
  @@map("student_transport_assignments")
}

/// Daily operational trip (Morning / Evening)
model TransportTrip {
  id                 String              @id @default(uuid())
  tenantId           String
  branchId           String?
  routeId            String
  vehicleId          String
  driverProfileId    String
  attendantProfileId String?
  tripDate           DateTime            @db.Date
  tripType           TripOperationalType
  status             TripStatus          @default(SCHEDULED)
  scheduledStartTime String              @default("08:00")
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  delayMinutes       Int                 @default(0)
  delayReason        String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id])
  route              TransportRoute      @relation(fields: [routeId], references: [id])
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id])
  driverProfile      StaffProfile        @relation("TripDriver", fields: [driverProfileId], references: [id])
  attendantProfile   StaffProfile?       @relation("TripAttendant", fields: [attendantProfileId], references: [id])

  manifest           TripManifestItem[]
  incidents          TransportIncident[]

  @@unique([tenantId, routeId, tripDate, tripType])
  @@index([tenantId, tripDate])
  @@index([tenantId, status])
  @@map("transport_trips")
}

/// Student manifest record for a specific trip
model TripManifestItem {
  id                 String              @id @default(uuid())
  tripId             String
  studentId          String
  stopId             String
  status             ManifestItemStatus  @default(EXPECTED)
  boardedAt          DateTime?
  droppedAt          DateTime?
  actionById         String?
  actionByName       String?
  verifiedGuardianId String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  trip               TransportTrip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop               RouteStop           @relation(fields: [stopId], references: [id])

  @@unique([tripId, studentId])
  @@index([tripId, status])
  @@map("trip_manifest_items")
}

/// Transport-specific operational or safety incident
model TransportIncident {
  id                 String                    @id @default(uuid())
  tenantId           String
  branchId           String?
  tripId             String?
  vehicleId          String?
  studentId          String?
  severity           TransportIncidentSeverity @default(MEDIUM)
  category           TransportIncidentCategory @default(OTHER)
  title              String
  description        String
  actionTaken        String?
  status             TransportIncidentStatus   @default(REPORTED)
  reportedById       String
  reportedByName     String
  resolvedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                   @relation(fields: [branchId], references: [id])
  trip               TransportTrip?            @relation(fields: [tripId], references: [id])
  vehicle            Vehicle?                  @relation(fields: [vehicleId], references: [id])
  student            Student?                  @relation(fields: [studentId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("transport_incidents")
}

enum PickupAuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  EXPIRED
  CANCELLED
}

enum TransportSecurityEventType {
  QR_SCAN
  PIN_VERIFICATION_SUCCESS
  PIN_VERIFICATION_FAILED
  UNAUTHORIZED_PICKUP_ATTEMPT
  UNAUTHORIZED_DROP_ATTEMPT
  UNKNOWN_PERSON_DETECTED
  AUTHORIZATION_APPROVED
  AUTHORIZATION_REJECTED
  DRIVER_LOGIN
  DRIVER_MISMATCH
  DUPLICATE_PICKUP_ATTEMPT
  DUPLICATE_DROP_ATTEMPT
  ARRIVAL_SUBMITTED
  ARRIVAL_VERIFIED
  ARRIVAL_REJECTED
  MANUAL_OVERRIDE
}

/// Temporary Authorized Pickup Person (Unknown/Alternate Pickup Workflow)
model TransportPickupAuthorization {
  id                 String                    @id @default(uuid())
  tenantId           String
  branchId           String?
  studentId          String
  guardianId         String?                   // Requesting guardian
  personName         String
  phone              String
  relationship       String
  actionType         String                    @default("PICKUP")
  reason             String
  validFrom          DateTime                  @db.Date
  validUntil         DateTime                  @db.Date
  isOneTime          Boolean                   @default(true)
  status             PickupAuthorizationStatus @default(PENDING)
  approvedById       String?
  approvedByName     String?
  approvedAt         DateTime?
  rejectionReason    String?
  usedAt             DateTime?
  usedById           String?
  usedByName         String?
  remarks            String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                   @relation(fields: [branchId], references: [id])
  student            Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian           Guardian?                 @relation(fields: [guardianId], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("transport_pickup_authorizations")
}

/// Audit and Security Event Log for Child Transport Safety
model TransportSecurityEvent {
  id                 String                     @id @default(uuid())
  tenantId           String
  branchId           String?
  eventType          TransportSecurityEventType
  studentId          String?
  driverProfileId    String?
  vehicleId          String?
  routeId            String?
  tripId             String?
  authorizationId    String?
  actorId            String
  actorName          String
  actorRole          String
  action             String
  result             String                     @default("SUCCESS")
  reason             String?
  ipAddress          String?
  userAgent          String?
  metadata           Json?
  createdAt          DateTime                   @default(now())

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?                    @relation(fields: [branchId], references: [id])
  student            Student?                   @relation(fields: [studentId], references: [id])

  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@map("transport_security_events")
}

/// Saved Custom Report Definition
model SavedReport {
  id             String           @id @default(uuid())
  tenantId       String
  branchId       String?
  name           String
  description    String?
  module         String           @default("GENERAL")
  source         String
  fields         Json             // Array of field keys string[]
  filters        Json             // Array of ReportFilter objects
  sortField      String?
  sortOrder      String?          @default("asc")
  groupBy        String?
  createdById    String
  createdByName  String
  isPublic       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?          @relation(fields: [branchId], references: [id])
  schedules      ReportSchedule[]

  @@index([tenantId, source])
  @@index([tenantId, createdById])
  @@map("saved_reports")
}

/// Report Automated Schedule
model ReportSchedule {
  id             String           @id @default(uuid())
  tenantId       String
  savedReportId  String
  frequency      String           @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  exportFormat   String           @default("CSV")    // CSV, XLSX, PDF
  recipients     Json             // Array of email / user ID strings
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedReport    SavedReport      @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([nextRunAt])
  @@map("report_schedules")
}

/// Central In-App Notification Aggregate
model InAppNotification {
  id             String           @id @default(uuid())
  tenantId       String
  userId         String
  title          String
  body           String
  category       String           @default("SYSTEM") // ATTENDANCE, HEALTH, SAFETY, FEES, TRANSPORT, HR, ACADEMICS, SYSTEM
  severity       String           @default("INFO")   // INFO, WARNING, URGENT, EMERGENCY
  linkUrl        String?
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId, createdAt])
  @@map("in_app_notifications")
}

/// Truthful Gateway & Channel Delivery Audit Log
model NotificationDeliveryLog {
  id               String         @id @default(uuid())
  tenantId         String
  eventId          String?
  eventType        String         // ATTENDANCE_UPDATE, HEALTH_ALERT, FEE_DUE, etc.
  channel          String         // IN_APP, EMAIL, SMS, WHATSAPP
  recipientType    String         // PARENT, STAFF, USER
  recipientId      String
  recipientAddress String?        // Email address, Phone number, or User ID
  title            String
  body             String
  status           String         // SENT, DELIVERED, FAILED, SKIPPED, CONFIGURATION_ONLY
  failureReason    String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("notification_delivery_logs")
}



// ═══════════════════════════════════════════════════════════════════════
// PREONE PLUS — School ERP Expansion (Exams · Timetable · Library · Hostel)
// ═══════════════════════════════════════════════════════════════════════

// ── Exam & Results Module ──

enum ExamType {
  UNIT_TEST
  CYCLE_TEST
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  ACTIVITY_ASSESSMENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum ExamResultStatus {
  PENDING
  PASS
  FAIL
}

model Exam {
  id                String      @id @default(uuid())
  tenantId          String
  academicSessionId String
  name              String
  code              String
  examType          ExamType    @default(UNIT_TEST)
  status            ExamStatus  @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  description       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  schedules         ExamSchedule[]
  reportCards       ReportCard[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([academicSessionId])
  @@map("exams")
}

model ExamSchedule {
  id            String     @id @default(uuid())
  tenantId      String
  examId        String
  classroomId   String
  subjectId     String
  examDate      DateTime
  startTime     String     // "09:30"
  endTime       String     // "10:30"
  maxMarks      Decimal    @default(100) @db.Decimal(6, 2)
  passingMarks  Decimal    @default(35) @db.Decimal(6, 2)
  invigilatorId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroom     Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject       Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  invigilator   User?      @relation("ExamInvigilator", fields: [invigilatorId], references: [id], onDelete: SetNull)
  marks         ExamMark[]

  @@unique([examId, classroomId, subjectId])
  @@index([tenantId, classroomId])
  @@index([tenantId, examDate])
  @@map("exam_schedules")
}

model ExamMark {
  id            String   @id @default(uuid())
  tenantId      String
  scheduleId    String
  studentId     String
  marksObtained Decimal? @db.Decimal(6, 2)
  grade         String?
  remarks       String?
  isAbsent      Boolean  @default(false)
  enteredById   String?
  enteredAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule      ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy     User?        @relation("ExamMarkEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([scheduleId, studentId])
  @@index([tenantId, studentId])
  @@map("exam_marks")
}

model ReportCard {
  id            String           @id @default(uuid())
  tenantId      String
  studentId     String
  examId        String
  classroomId   String
  totalMarks    Decimal          @default(0) @db.Decimal(8, 2)
  obtainedMarks Decimal          @default(0) @db.Decimal(8, 2)
  percentage    Decimal          @default(0) @db.Decimal(5, 2)
  grade         String?
  rank          Int?
  result        ExamResultStatus @default(PENDING)
  remarks       String?
  generatedById String?
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  generatedBy   User?     @relation("ReportCardGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([studentId, examId])
  @@index([tenantId, examId])
  @@index([tenantId, classroomId])
  @@map("report_cards")
}

// ── Timetable Module ──

enum TimetableDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimetableSlot {
  id                String       @id @default(uuid())
  tenantId          String
  academicSessionId String
  classroomId       String
  day               TimetableDay
  periodNumber      Int
  startTime         String       // "09:00"
  endTime           String       // "09:40"
  label             String?      // "Lunch Break", "Games" for non-teaching slots
  subjectId         String?
  teacherId         String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  classroom         Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject           Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher           User?           @relation("SlotTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classroomId, day, periodNumber])
  @@index([tenantId, teacherId])
  @@index([academicSessionId])
  @@map("timetable_slots")
}

// ── Library Module ──

enum BookStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  WITHDRAWN
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

model Book {
  id              String     @id @default(uuid())
  tenantId        String
  title           String
  author          String?
  isbn            String?
  category        String?
  publisher       String?
  language        String     @default("English")
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  shelfLocation   String?
  priceCents      Int?
  status          BookStatus @default(AVAILABLE)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues          BookIssue[]

  @@index([tenantId, title])
  @@index([tenantId, category])
  @@map("books")
}

model BookIssue {
  id          String          @id @default(uuid())
  tenantId    String
  bookId      String
  studentId   String?
  staffUserId String?
  issuedById  String?
  issuedAt    DateTime        @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  fineCents   Int             @default(0)
  status      BookIssueStatus @default(ISSUED)
  remarks     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staffUser   User?    @relation("BookIssueStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  issuedBy    User?    @relation("BookIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, bookId])
  @@index([tenantId, studentId])
  @@map("book_issues")
}

// ── Hostel Module (optional add-on) ──

enum HostelRoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
}

enum HostelAllocationStatus {
  ACTIVE
  VACATED
}

model HostelRoom {
  id              String           @id @default(uuid())
  tenantId        String
  branchId        String
  roomNumber      String
  block           String?
  floor           String?
  roomType        String           @default("SHARING") // SHARING, PRIVATE, DORMITORY
  capacity        Int              @default(4)
  occupied        Int              @default(0)
  monthlyFeeCents Int?
  status          HostelRoomStatus @default(AVAILABLE)
  notes           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  allocations     HostelAllocation[]

  @@unique([tenantId, branchId, roomNumber])
  @@index([tenantId, branchId])
  @@map("hostel_rooms")
}

model HostelAllocation {
  id          String                 @id @default(uuid())
  tenantId    String
  roomId      String
  studentId   String
  bedNumber   String?
  allocatedAt DateTime               @default(now())
  vacatedAt   DateTime?
  status      HostelAllocationStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("hostel_allocations")
}

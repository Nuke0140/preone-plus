  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  vendor             Vendor             @relation(fields: [vendorId], references: [id])
  items              GoodsReceiptItem[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  itemId              String
  locationId          String
  orderedQuantity     Decimal           @db.Decimal(12, 4)
  receivedQuantity    Decimal           @db.Decimal(12, 4)
  acceptedQuantity    Decimal           @db.Decimal(12, 4)
  rejectedQuantity    Decimal           @default(0) @db.Decimal(12, 4)
  unitCost            Decimal           @db.Decimal(12, 2)
  batchNumber         String?
  expiryDate          DateTime?
  serialNumber        String?
  rejectionReason     String?

  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  item                InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location            InventoryLocation @relation(fields: [locationId], references: [id])

  @@map("goods_receipt_items")
}

model StockIssue {
  id                 String           @id @default(uuid())
  tenantId           String
  branchId           String
  academicSessionId  String?
  issueNumber        String
  materialRequestId  String?
  locationId         String
  destinationType    DestinationType  @default(CLASSROOM)
  destinationId      String?
  classroomId        String?
  studentId          String?
  issuedById         String
  issuedByName       String
  recipientName      String?
  status             StockIssueStatus @default(COMPLETED)
  issueDate          DateTime         @default(now())
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

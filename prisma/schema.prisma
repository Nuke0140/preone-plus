  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffProfileId, trainingType])
  @@map("staff_trainings")
}

/// Daily staff attendance punch records
model AttendanceStaff {
  id             String                @id @default(uuid())
  tenantId       String
  branchId       String
  staffProfileId String
  date           DateTime              @db.Date
  status         StaffAttendanceStatus
  checkIn        DateTime?
  checkOut       DateTime?
  source         AttendanceSource      @default(MANUAL)
  shiftHours     Float                 @default(8.0)
  workedHours    Float                 @default(0.0)
  lateMinutes    Int                   @default(0)
  notes          String?
  markedById     String?
  markedByName   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile          @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, date])
  @@index([tenantId, branchId, date])
  @@map("attendance_staff")
}

/// Configurable leave types (CL, SL, EL, ML, etc.)
model LeaveType {
  id                  String         @id @default(uuid())
  tenantId            String
  name                String
  code                String
  annualQuota         Float
  carryForwardAllowed Boolean        @default(false)
  maxCarryForward     Float          @default(0.0)
  isPaid              Boolean        @default(true)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances            LeaveBalance[]
  requests            LeaveRequest[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

/// Fiscal leave balance per staff member (April-March cycle)
model LeaveBalance {
  id             String       @id @default(uuid())
  tenantId       String
  staffProfileId String
  leaveTypeId    String
  year           Int          // Fiscal starting year, e.g. 2026
  totalCredited  Float
  consumed       Float        @default(0.0)
  pending        Float        @default(0.0)
  balance        Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, leaveTypeId, year])
  @@index([tenantId, staffProfileId])
  @@map("leave_balances")
}

/// Leave requests submitted by staff
model LeaveRequest {
  id              String             @id @default(uuid())
  tenantId        String
  staffProfileId  String
  leaveTypeId     String
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  totalDays       Float
  reason          String
  status          LeaveRequestStatus @default(PENDING)
  appliedAt       DateTime           @default(now())
  actionedById    String?
  actionedByName  String?
  actionedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile    StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  coverages       LeaveCoverage[]

  @@index([tenantId, staffProfileId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

/// Teacher absence classroom coverage mapping
model LeaveCoverage {
  id                 String         @id @default(uuid())
  leaveRequestId     String
  classroomId        String
  date               DateTime       @db.Date
  substituteStaffId  String?
  coordinatorStaffId String?
  status             CoverageStatus @default(ASSIGNED)
  notificationSent   Boolean        @default(false)
  notes              String?
  createdAt          DateTime       @default(now())

  leaveRequest       LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  classroom          Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId, classroomId])
  @@map("leave_coverages")
}

/// Base salary structure for employee
model StaffSalaryStructure {
  id               String       @id @default(uuid())
  tenantId         String
  staffProfileId   String       @unique
  basicSalary      Decimal      @db.Decimal(12, 2)
  hra              Decimal      @db.Decimal(12, 2)
  specialAllowance Decimal      @db.Decimal(12, 2)
  pfEligible       Boolean      @default(true)
  esiEligible      Boolean      @default(false)
  ptApplicable     Boolean      @default(true)
  tdsRate          Decimal      @default(0.0) @db.Decimal(5, 2)
  effectiveFrom    DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile     StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@map("staff_salary_structures")
}

/// Monthly payroll processing cycle
model PayrollCycle {
  id                   String             @id @default(uuid())
  tenantId             String
  branchId             String?
  month                Int
  year                 Int
  attendanceCutoffDate DateTime           @db.Date
  status               PayrollCycleStatus @default(DRAFT)
  totalStaff           Int                @default(0)
  totalGross           Decimal            @default(0) @db.Decimal(12, 2)
  totalDeductions      Decimal            @default(0) @db.Decimal(12, 2)
  totalNetPayable      Decimal            @default(0) @db.Decimal(12, 2)
  processedById        String?
  processedByName      String?
  lockedAt             DateTime?
  disbursedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payslips             Payslip[]

  @@unique([tenantId, month, year])
  @@index([tenantId, status])
  @@map("payroll_cycles")
}

/// Individual staff payslip generated during payroll cycle
model Payslip {
  id                 String        @id @default(uuid())
  tenantId           String
  payrollCycleId     String
  staffProfileId     String
  presentDays        Float         @default(0.0)
  absentDays         Float         @default(0.0)
  paidLeaveDays      Float         @default(0.0)
  unpaidLeaveDays    Float         @default(0.0)
  basicEarned        Decimal       @default(0) @db.Decimal(12, 2)
  hraEarned          Decimal       @default(0) @db.Decimal(12, 2)
  allowanceEarned    Decimal       @default(0) @db.Decimal(12, 2)
  grossEarnings      Decimal       @default(0) @db.Decimal(12, 2)
  pfDeduction        Decimal       @default(0) @db.Decimal(12, 2)
  esiDeduction       Decimal       @default(0) @db.Decimal(12, 2)
  ptDeduction        Decimal       @default(0) @db.Decimal(12, 2)
  tdsDeduction       Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions    Decimal       @default(0) @db.Decimal(12, 2)
  netSalary          Decimal       @default(0) @db.Decimal(12, 2)
  poshCompliant      Boolean       @default(true)
  isHeld             Boolean       @default(false)
  holdReason         String?
  status             PayslipStatus @default(PENDING)
  paymentReference   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollCycle       PayrollCycle  @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  staffProfile       StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([payrollCycleId, staffProfileId])
  @@index([tenantId, staffProfileId])
  @@map("payslips")
}

/// Performance appraisal cycle
model ReviewCycle {
  id          String            @id @default(uuid())
  tenantId    String
  title       String
  cycleType   ReviewCycleType   @default(ANNUAL)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  status      ReviewCycleStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews     StaffReview[]

  @@index([tenantId, status])
  @@map("review_cycles")
}

/// Staff review entry
model StaffReview {
  id              String               @id @default(uuid())
  tenantId        String
  reviewCycleId   String
  staffProfileId  String
  reviewerId      String?
  selfRating      Float?
  selfComments    String?
  reviewerRating  Float?
  reviewerComments String?
  finalRating     Float?
  recommendation  ReviewRecommendation @default(NONE)
  status          StaffReviewStatus    @default(PENDING_SELF)
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewCycle     ReviewCycle          @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)
  staffProfile    StaffProfile         @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([reviewCycleId, staffProfileId])
  @@index([tenantId, staffProfileId])
  @@map("staff_reviews")
}

/// Recruitment job openings
model JobOpening {

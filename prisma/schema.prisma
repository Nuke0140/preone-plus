  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffProfileId])
  @@map("staff_qualifications")
}

/// Confidential employee bank payout details
model StaffBankDetail {
  id                     String       @id @default(uuid())
  tenantId               String
  staffProfileId         String       @unique
  accountHolderName      String
  bankName               String
  accountNumberMasked    String
  accountNumberEncrypted String
  ifscCode               String
  branchName             String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile           StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("staff_bank_details")
}

/// Staff statutory trainings (POSH, Food Handler Medical, Child Protection)
model StaffTraining {
  id             String         @id @default(uuid())
  tenantId       String
  staffProfileId String
  trainingType   TrainingType
  completionDate DateTime
  expiryDate     DateTime
  score          Float?
  certificateUrl String?
  status         TrainingStatus @default(VALID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                     @id @default(uuid())
  name                   String
  code                   String                     @unique
  type                   TenantType                 @default(SCHOOL)
  status                 TenantStatus               @default(PENDING_ACTIVATION)
  subscriptionPlan       SubscriptionPlanCode       @default(STARTER)
  maxBranches            Int                        @default(1)
  maxStudents            Int                        @default(100)
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  phone                  String?
  email                  String?
  website                String?
  logoUrl                String?
  principalSignatureUrl String?
  gstNumber              String?
  panNumber              String?
  academicYearStartMonth Int                        @default(4)
  timezone               String                     @default("Asia/Kolkata")
  locale                 String                     @default("en-IN")
  onboardingStep         Int                        @default(0)
  onboardedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deletedAt              DateTime?
  academicSessions       AcademicSession[]
  applications           AdmissionApplication[]
  announcements          Announcement[]
  attendance             Attendance[]
  auditLogs              AuditLog[]
  branches               Branch[]
  calendarEvents         CalendarEvent[]
  classrooms             Classroom[]
  leads                  Lead[]
  facilities             Facility[]
  feeHeads               FeeHead[]
  feePlans               FeePlan[]
  followUps              FollowUp[]
  guardians              Guardian[]
  invoices               Invoice[]
  observations           Observation[]
  payments               Payment[]
  programs               Program[]
  receipts               Receipt[]
  schoolConfigs          SchoolConfig[]
  setupSteps             SchoolSetupStep[]
  setupValidations       SchoolSetupValidationRun[]
  schoolSetup            SchoolSetup?
  staffProfiles          StaffProfile[]
  allocations            StudentAllocation[]
  students               Student[]
  members                TenantUser[]
  timelineEntries        TimelineEntry[]
  backgroundJobs         BackgroundJob[]
  documentTemplates      DocumentTemplate[]
  customRoles            CustomRole[]
  offers                 AdmissionOffer[]
  curriculums            Curriculum[]
  curriculumLearningAreas CurriculumLearningArea[]
  learningGoals          LearningGoal[]
  classroomActivities    ClassroomActivity[]
  studentProgresses      StudentProgress[]
  inventoryCategories    InventoryCategory[]
  inventoryUnits         InventoryUnit[]
  vendors                Vendor[]
  inventoryLocations     InventoryLocation[]
  inventoryItems         InventoryItem[]
  inventoryStocks        InventoryStock[]
  stockMovements         StockMovement[]
  materialRequests       MaterialRequest[]
  purchaseRequests       PurchaseRequest[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  stockIssues            StockIssue[]
  stockReturns           StockReturn[]
  stockAdjustments       StockAdjustment[]

  // HR Relations
  staffDocuments         StaffDocument[]
  staffQualifications    StaffQualification[]
  staffBankDetails       StaffBankDetail[]
  staffTrainings         StaffTraining[]
  attendanceStaff        AttendanceStaff[]
  leaveTypes             LeaveType[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  salaryStructures       StaffSalaryStructure[]
  payrollCycles          PayrollCycle[]
  payslips               Payslip[]
  reviewCycles           ReviewCycle[]
  staffReviews           StaffReview[]
  jobOpenings            JobOpening[]
  jobApplications        JobApplication[]
  resignationRequests    ResignationRequest[]
  offboardingTasks       OffboardingTask[]

  // Transport Relations
  vehicles                    Vehicle[]
  transportRoutes             TransportRoute[]
  routeStops                  RouteStop[]
  studentTransportAssignments StudentTransportAssignment[]
  transportTrips              TransportTrip[]
  transportIncidents          TransportIncident[]
  pickupAuthorizations        TransportPickupAuthorization[]
  transportSecurityEvents     TransportSecurityEvent[]

  // Reports & Analytics Relations
  savedReports                SavedReport[]
  reportSchedules             ReportSchedule[]

  // Notifications & Communication Relations
  inAppNotifications          InAppNotification[]
  notificationDeliveryLogs    NotificationDeliveryLog[]

  // Academic Subject Relations (M00 / M02)
  subjects                    Subject[]
  programSubjects             ProgramSubject[]
  classroomSubjects           ClassroomSubject[]

  // PreOne Plus: Exams / Timetable / Library / Hostel
  exams             Exam[]
  examSchedules     ExamSchedule[]
  examMarks         ExamMark[]
  reportCards       ReportCard[]
  timetableSlots    TimetableSlot[]
  books             Book[]
  bookIssues        BookIssue[]
  hostelRooms       HostelRoom[]
  hostelAllocations HostelAllocation[]

  @@map("tenants")
}

model Branch {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  timingOpen     String          @default("08:30")
  timingClose    String          @default("16:00")
  capacity       Int?
  isMain         Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  calendarEvents CalendarEvent[]
  facilities         Facility[]
  staffProfiles      StaffProfile[]
  inventoryLocations InventoryLocation[]
  inventoryStocks    InventoryStock[]
  stockMovements     StockMovement[]
  materialRequests   MaterialRequest[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  stockIssues        StockIssue[]
  stockReturns       StockReturn[]
  stockAdjustments   StockAdjustment[]

  // HR Relations
  attendanceStaff    AttendanceStaff[]
  payrollCycles      PayrollCycle[]
  jobOpenings        JobOpening[]

  // Transport Relations
  vehicles                    Vehicle[]
  transportRoutes             TransportRoute[]
  studentTransportAssignments StudentTransportAssignment[]
  transportTrips              TransportTrip[]
  transportIncidents          TransportIncident[]
  pickupAuthorizations        TransportPickupAuthorization[]
  transportSecurityEvents     TransportSecurityEvent[]
  hostelRooms                 HostelRoom[]

  // Reports & Analytics Relations
  savedReports                SavedReport[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id              String        @id @default(uuid())
  email           String?       @unique
  username        String?       @unique
  phone           String?
  passwordHash    String
  fullName        String
  avatarUrl       String?
  status          UserStatus    @default(ACTIVE)
  locale          String        @default("en-IN")
  preferences     Json?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  taughtClasses   Classroom[]   @relation("ClassPrimaryTeacher")
  guardianProfile Guardian?     @relation("GuardianPortalUser")
  staffProfile    StaffProfile?
  memberships     TenantUser[]
  conductedActivities ClassroomActivity[]
  assessedProgresses  StudentProgress[]
  inAppNotifications  InAppNotification[]
  sessions        UserSession[]
  specialistSubjects ClassroomSubject[] @relation("SubjectSpecialistTeacher")

  // PreOne Plus: Exams / Timetable / Library
  invigilatedSchedules    ExamSchedule[]  @relation("ExamInvigilator")
  marksEntered            ExamMark[]      @relation("ExamMarkEnteredBy")
  reportCardsGenerated    ReportCard[]    @relation("ReportCardGeneratedBy")
  timetableSlots          TimetableSlot[] @relation("SlotTeacher")
  bookIssuesAsStaff       BookIssue[]     @relation("BookIssueStaff")
  booksIssuedBy           BookIssue[]     @relation("BookIssuedBy")

  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String?
  tokenHash    String    @unique
  device       String?
  platform     String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tokenHash])
  @@map("user_sessions")
}

model TenantUser {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      UserRole
  roles     UserRole[] @default([])
  branchId  String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_users")
}

model AcademicSession {
  id              String                @id @default(uuid())
  tenantId        String
  name            String
  startDate       DateTime
  endDate         DateTime
  status          AcademicSessionStatus @default(ACTIVE)
  isCurrent       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances     Attendance[]
  calendarEvents  CalendarEvent[]
  classrooms      Classroom[]
  invoices        Invoice[]
  observations    Observation[]
  allocations     StudentAllocation[]
  timelineEntries TimelineEntry[]
  applications    AdmissionApplication[]
  curriculums         Curriculum[]
  classroomActivities ClassroomActivity[]
  studentProgresses   StudentProgress[]
  stockMovements      StockMovement[]
  materialRequests    MaterialRequest[]
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  stockIssues         StockIssue[]
  studentTransportAssignments StudentTransportAssignment[]
  exams               Exam[]
  timetableSlots      TimetableSlot[]

  @@unique([tenantId, name])
  @@map("academic_sessions")
}

model Classroom {
  id                String              @id @default(uuid())
  tenantId          String
  branchId          String
  academicSessionId String
  name              String
  code              String
  programType       ProgramType
  capacity          Int                 @default(20)
  primaryTeacherId  String?
  ageBandMinMonths  Int?
  ageBandMaxMonths  Int?
  programId         String?
  facilityId        String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attendances       Attendance[]
  academicSession   AcademicSession     @relation(fields: [academicSessionId], references: [id])
  facility          Facility?           @relation(fields: [facilityId], references: [id])
  primaryTeacher    User?               @relation("ClassPrimaryTeacher", fields: [primaryTeacherId], references: [id])
  program           Program?            @relation(fields: [programId], references: [id])
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUps         FollowUp[]
  observations      Observation[]
  allocations       StudentAllocation[]
  students          Student[]           @relation("StudentCurrentClassroom")
  activities        ClassroomActivity[]
  materialRequests  MaterialRequest[]
  stockIssues       StockIssue[]
  leaveCoverages    LeaveCoverage[]
  subjectMappings   ClassroomSubject[]
  examSchedules     ExamSchedule[]
  timetableSlots    TimetableSlot[]
  reportCards       ReportCard[]

  @@unique([tenantId, code])
  @@index([branchId])
  @@map("classrooms")
}

model Student {
  id                 String              @id @default(uuid())
  tenantId           String
  branchId           String
  admissionNo        String
  username           String?             @unique
  firstName          String
  lastName           String?
  dob                DateTime
  gender             Gender
  status             StudentStatus       @default(ACTIVE)
  admissionDate      DateTime            @default(now())
  photoUrl           String?
  bloodGroup         BloodGroup?
  address            String?
  currentClassroomId String?
  seatNumber         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attendances        Attendance[]
  followUps          FollowUp[]
  invoices           Invoice[]
  observations       Observation[]
  payments           Payment[]
  allocations        StudentAllocation[]
  guardians          StudentGuardian[]
  currentClassroom   Classroom?          @relation("StudentCurrentClassroom", fields: [currentClassroomId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  timelineEntries    TimelineEntry[]
  progressRecords    StudentProgress[]
  stockIssues        StockIssue[]
  transportAssignments StudentTransportAssignment[]
  tripManifestItems    TripManifestItem[]
  transportIncidents   TransportIncident[]
  pickupAuthorizations TransportPickupAuthorization[]
  transportSecurityEvents TransportSecurityEvent[]
  examMarks         ExamMark[]
  reportCards       ReportCard[]
  bookIssues        BookIssue[]
  hostelAllocations HostelAllocation[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, seatNumber])
  @@index([currentClassroomId])
  @@map("students")
}

model Guardian {
  id               String            @id @default(uuid())
  tenantId         String
  fullName         String
  relationship     Relationship
  phone            String
  email            String?
  occupation       String?
  isPrimaryContact Boolean           @default(false)
  userId           String?           @unique
  pickupPin        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?             @relation("GuardianPortalUser", fields: [userId], references: [id])
  studentLinks     StudentGuardian[]
  applications     AdmissionApplication[]
  pickupAuthorizations TransportPickupAuthorization[]

  @@index([tenantId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id           String        @id @default(uuid())
  studentId    String
  guardianId   String
  relationship Relationship?
  isPrimary    Boolean       @default(false)
  canPickup    Boolean       @default(true)
  pickupPin    String?
  isFeePayer   Boolean       @default(true)
  receivesComm Boolean       @default(true)
  createdAt    DateTime      @default(now())
  guardian     Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Lead {
  id                     String                 @id @default(uuid())
  tenantId               String
  branchId               String?
  leadNumber             String
  source                 LeadSource             @default(WALK_IN)
  status                 LeadStatus             @default(NEW)
  parentName             String
  phone                  String
  email                  String?
  childName              String?
  childDob               DateTime?
  interestedProgram      ProgramType?
  notes                  String?
  assignedToId           String?
  nextFollowUpAt         DateTime?
  convertedApplicationId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  applications           AdmissionApplication[]
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadNumber])
  @@index([tenantId, status])
  @@map("crm_leads")
}

model AdmissionApplication {
  id                       String                @id @default(uuid())
  tenantId                 String
  branchId                 String
  academicSessionId        String
  applicationNumber        String
  leadId                   String?
  programId                String?
  programType              ProgramType
  childFirstName           String
  childLastName            String?
  childDob                 DateTime
  childGender              Gender
  parentName               String
  parentPhone              String
  parentEmail              String?
  previousSchool           String?
  guardianId               String?
  status                   ApplicationStatus     @default(SUBMITTED)
  submittedAt              DateTime?
  verifiedAt               DateTime?
  approvedAt               DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  isDuplicateConfirmed     Boolean               @default(false)
  duplicateOfApplicationId String?
  notes                    String?
  studentId                String?
  classroomId              String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  deletedAt                DateTime?
  lead                     Lead?                 @relation(fields: [leadId], references: [id])
  tenant                   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession          AcademicSession       @relation(fields: [academicSessionId], references: [id])
  program                  Program?              @relation(fields: [programId], references: [id])
  guardian                 Guardian?             @relation(fields: [guardianId], references: [id])
  documents                ApplicationDocument[]
  offers                   AdmissionOffer[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, status])
  @@index([tenantId, academicSessionId])
  @@index([branchId])
  @@index([tenantId, programId])
  @@map("admission_applications")
}

model AdmissionOffer {
  id              String                @id @default(uuid())
  tenantId        String
  applicationId   String
  offerNumber     String
  childName       String
  parentName      String
  programType     ProgramType
  feePlanId       String?
  feeTotalCents   Int                   @default(0)
  terms           String?
  status          OfferStatus           @default(DRAFT)
  validFrom       DateTime              @default(now())
  validUntil      DateTime
  issuedAt        DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?
  acceptNote      String?
  declineReason   String?
  createdById     String?
  createdAt       DateTime              @default(now())
  application     AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, applicationId])
  @@map("admission_offers")
}

model ApplicationDocument {
  id               String               @id @default(uuid())
  applicationId    String
  docType          DocumentType
  fileName         String
  status           DocumentStatus       @default(UPLOADED)
  verified         Boolean              @default(false)
  uploadedAt       DateTime             @default(now())
  verifiedAt       DateTime?
  remarks          String?
  rejectionReason  String?
  createdAt        DateTime             @default(now())
  application      AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}

model Attendance {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  classroomId       String
  studentId         String
  date              DateTime         @db.Date
  status            AttendanceStatus
  notes             String?
  markedById        String?
  markedAt          DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  academicSessionId String?
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  classroom         Classroom        @relation(fields: [classroomId], references: [id])
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classroomId, date])
  @@index([tenantId, date])
  @@map("attendance")
}

model FeeHead {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  code        String
  category    FeeHeadCategory  @default(OTHER)
  description String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  planItems   FeePlanItem[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("fee_heads")
}

model FeePlan {
  id               String        @id @default(uuid())
  tenantId         String
  branchId         String?
  name             String
  programType      ProgramType
  totalAnnualCents Int
  installmentCount Int           @default(1)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            FeePlanItem[]
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, programType])
  @@map("fee_plans")
}

model FeePlanItem {
  id          String          @id @default(uuid())
  feePlanId   String
  feeHeadId   String?
  feeHead     FeeHeadCategory
  label       String
  amountCents Int
  frequency   FeeFrequency
  feePlan     FeePlan         @relation(fields: [feePlanId], references: [id], onDelete: Cascade)
  feeHeadRef  FeeHead?        @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)

  @@map("fee_plan_items")
}

model Invoice {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String
  studentId         String?
  vendorId          String?
  purchaseOrderId   String?
  invoiceType       InvoiceType      @default(STUDENT_FEE)
  invoiceNumber     String
  title             String           @default("Fee Invoice")
  issueDate         DateTime         @default(now())
  dueDate           DateTime
  subtotalCents     Int
  discountCents     Int              @default(0)
  taxCents          Int              @default(0)
  totalCents        Int
  paidCents         Int              @default(0)
  balanceCents      Int
  status            InvoiceStatus    @default(ISSUED)
  notes             String?
  issuedById        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  academicSessionId String?
  items             InvoiceItem[]
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  student           Student?         @relation(fields: [studentId], references: [id])
  vendor            Vendor?          @relation(fields: [vendorId], references: [id])
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  payments          Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([studentId])
  @@index([vendorId])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  feeHead     FeeHeadCategory
  description String
  amountCents Int
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  invoiceId      String?
  studentId      String?
  vendorId       String?
  paymentNumber  String
  amountCents    Int
  method         PaymentMethod
  transactionRef String?
  status         PaymentStatus @default(SUCCESS)
  paymentDate    DateTime      @default(now())
  receivedById   String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  student        Student?      @relation(fields: [studentId], references: [id])
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  receipt        Receipt?

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, status])
  @@index([studentId])
  @@index([vendorId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  receiptNumber String
  amountCents   Int
  issuedAt      DateTime @default(now())
  tenantId      String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@map("receipts")
}

model Announcement {
  id          String             @id @default(uuid())
  tenantId    String
  branchId    String?
  classroomId String?
  title       String
  body        String
  type        AnnouncementType   @default(GENERAL)
  audience    AudienceType       @default(SCHOOL_WIDE)
  status      AnnouncementStatus @default(PUBLISHED)
  authorId    String?
  publishedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
  @@map("announcements")
}

model TimelineEntry {
  id                String            @id @default(uuid())
  tenantId          String
  studentId         String
  classroomId       String?
  type              TimelineEntryType
  title             String
  body              String?
  mood              String?
  photoUrl          String?
  authorId          String?
  observationId     String?
  createdAt         DateTime          @default(now())
  academicSessionId String?
  academicSession   AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  observation       Observation?      @relation(fields: [observationId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([tenantId, createdAt])
  @@map("timeline_entries")
}

model Observation {
  id                String             @id @default(uuid())
  tenantId          String
  studentId         String
  classroomId       String?
  teacherId         String?
  narrative         String
  milestoneTags     String?
  status            ObservationStatus  @default(DRAFT)
  category          String?
  concern           ObservationConcern @default(NORMAL)
  observedAt        DateTime           @default(now())
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  academicSessionId String?
  academicSession   AcademicSession?   @relation(fields: [academicSessionId], references: [id])
  classroom         Classroom?         @relation(fields: [classroomId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeline          TimelineEntry[]
  learningGoalId    String?
  activityId        String?
  learningGoal      LearningGoal?      @relation(fields: [learningGoalId], references: [id], onDelete: SetNull)
  activity          ClassroomActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
  @@map("observations")
}

/// The ONE reusable exception + follow-up aggregate. Raised by domain events
/// (absence, health, safety, learning, finance...); resolved by a human —
/// notification alone never resolves (M01 §42/§43).
model FollowUp {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String?
  academicSessionId String?
  classroomId       String?
  studentId         String?
  domain            FollowUpDomain
  severity          FollowUpSeverity @default(WARNING)
  status            FollowUpStatus   @default(OPEN)
  sourceType        String
  sourceId          String?
  dedupeKey         String?          @unique
  title             String
  detail            String?
  responsibleRole   UserRole         @default(TEACHER)
  assignedToId      String?
  dueAt             DateTime?
  actionTaken       String?
  outcome           String?
  resolvedAt        DateTime?
  resolvedByName    String?
  closedAt          DateTime?
  createdById       String?
  createdByName     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  classroom         Classroom?       @relation(fields: [classroomId], references: [id])
  student           Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([studentId])
  @@map("follow_ups")
}

/// Per-academic-year allocation history — mutable per year, history never
/// overwritten (M01 §10). Student.currentClassroomId stays the live pointer.
model StudentAllocation {
  id                String                  @id @default(uuid())
  tenantId          String
  studentId         String
  academicSessionId String
  classroomId       String
  programType       ProgramType
  status            StudentAllocationStatus @default(ACTIVE)
  startedAt         DateTime                @default(now())
  endedAt           DateTime?
  reason            String?
  createdById       String?
  createdByName     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  academicSession   AcademicSession         @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classroom         Classroom               @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([academicSessionId])
  @@index([classroomId])
  @@map("student_allocations")
}

model AuditLog {
  id                String   @id @default(uuid())
  tenantId          String?
  branchId          String?
  academicSessionId String?
  actorId           String?
  actorName         String?
  actorRole         String?
  action            String
  entity            String
  entityId          String?
  module            String?
  summary           String?
  severity          String   @default("INFO")
  ipAddress         String?
  userAgent         String?
  requestId         String?
  oldValues         Json?
  newValues         Json?
  createdAt         DateTime @default(now())
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@index([tenantId, module])
  @@map("audit_logs")
}

model BackgroundJob {
  id          String    @id @default(uuid())
  tenantId    String
  jobType     String    // BULK_INVOICE, BULK_RECEIPT, PAYMENT_EXPORT, DATA_EXPORT
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  progress    Int       @default(0)
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, jobType])
  @@map("background_jobs")
}

model DocumentTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // ID_CARD, CERTIFICATE, INVOICE, RECEIPT
  name        String
  content     Json
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, name])
  @@map("document_templates")
}

/// School-defined custom role (permission set) — assignable via per-user permission overrides
model CustomRole {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  permissions   String[] // e.g. ["library:read", "library:write"]
  baseRole      UserRole? // optional canonical role this custom role extends
  isSystem      Boolean  @default(false)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("custom_roles")
}

/// Persistent setup state machine — exactly one per tenant (M00 §3)
model SchoolSetup {
  id               String      @id @default(uuid())
  tenantId         String      @unique
  status           SetupStatus @default(NOT_STARTED)
  startedAt        DateTime?
  goLiveAt         DateTime?
  goLiveByName     String?
  lastValidationAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("school_setups")
}

/// Per-step persistent state: who/when completed, why blocked, drift detection (M00 §3)
model SchoolSetupStep {
  id                     String             @id @default(uuid())
  tenantId               String
  stepKey                String
  status                 SetupStepStatus    @default(PENDING)
  applicability          SetupApplicability @default(MANDATORY)
  blockedReason          String?
  completedById          String?
  completedByName        String?
  completedAt            DateTime?
  dataSnapshot           Json?
  changedAfterCompletion Boolean            @default(false)
  lastCheckedAt          DateTime           @default(now())
  lastUpdatedById        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stepKey])
  @@index([tenantId, status])
  @@map("school_setup_steps")
}

/// Persisted validation / go-live check runs (M00 §28)
model SchoolSetupValidationRun {
  id        String            @id @default(uuid())
  tenantId  String
  kind      ValidationKind
  overall   ValidationOverall
  result    Json
  runById   String?
  runByName String?
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("school_setup_validation_runs")
}

/// Configurable program master data (M00 §5/§9) — legacy ProgramType link kept for existing contracts
model Program {
  id             String      @id @default(uuid())
  tenantId       String
  code           String
  name           String
  programType    ProgramType
  description    String?
  ageMinMonths   Int?
  ageMaxMonths   Int?
  durationMonths Int?
  capacity       Int         @default(20)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  classrooms     Classroom[]
  applications   AdmissionApplication[]
  curriculums    Curriculum[]
  subjectMappings ProgramSubject[]
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("programs")
}

/// Academic Subject Master (M00 / M02)
model Subject {
  id                String             @id @default(uuid())
  tenantId          String
  code              String
  name              String
  shortName         String?
  description       String?
  subjectType       SubjectType        @default(CORE)
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programMappings   ProgramSubject[]
  classroomMappings ClassroomSubject[]
  examSchedules     ExamSchedule[]
  timetableSlots    TimetableSlot[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("subjects")
}

/// Program to Subject Mapping
model ProgramSubject {
  id         String   @id @default(uuid())
  tenantId   String
  programId  String
  subjectId  String
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([programId, subjectId])
  @@index([tenantId, programId])
  @@map("program_subjects")
}

/// Classroom to Subject Mapping (with Optional Specialist Teacher)
model ClassroomSubject {
  id                  String       @id @default(uuid())
  tenantId            String
  classroomId         String
  subjectId           String
  specialistTeacherId String?
  createdAt           DateTime     @default(now())

  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroom           Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject             Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  specialistTeacher   User?        @relation("SubjectSpecialistTeacher", fields: [specialistTeacherId], references: [id], onDelete: SetNull)

  @@unique([classroomId, subjectId])
  @@index([tenantId, classroomId])
  @@map("classroom_subjects")
}

/// Infrastructure tree: Branch → Facility (M00 §6/§10)
model Facility {
  id             String       @id @default(uuid())
  tenantId       String
  branchId       String
  type           FacilityType
  name           String
  code           String
  capacity       Int?
  floorOrArea    String?
  ageSuitability String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  classrooms     Classroom[]
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("facilities")
}

/// Staff employment foundation — identity/RBAC stays in User + TenantUser (M00 §9)
model StaffProfile {
  id                    String         @id @default(uuid())
  tenantId              String
  userId                String         @unique
  branchId              String?
  employeeCode          String
  designation           String?
  department            String?
  qualification         String?
  joiningDate           DateTime?
  employmentType        EmploymentType @default(FULL_TIME)
  emergencyContactName  String?
  emergencyContactPhone String?
  status                UserStatus     @default(ACTIVE)
  
  // HR profile extensions
  dateOfBirth           DateTime?
  gender                Gender?
  maritalStatus         String?
  bloodGroup            BloodGroup?
  currentAddress        String?
  permanentAddress      String?
  panNumber             String?
  aadhaarNumber         String?
  uanNumber             String?
  esiNumber             String?
  probationEndDate      DateTime?
  confirmationDate      DateTime?
  noticePeriodDays      Int            @default(60)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  branch                Branch?        @relation(fields: [branchId], references: [id])
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // HR Relations
  documents             StaffDocument[]
  qualifications        StaffQualification[]
  bankDetails           StaffBankDetail?
  trainings             StaffTraining[]
  attendanceRecords     AttendanceStaff[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  salaryStructure       StaffSalaryStructure?
  payslips              Payslip[]
  reviews               StaffReview[]
  resignation           ResignationRequest?
  offboardingTasks      OffboardingTask[]

  // Transport Relations
  drivenRoutes          TransportRoute[] @relation("RouteDriver")
  attendedRoutes        TransportRoute[] @relation("RouteAttendant")
  drivenTrips           TransportTrip[]  @relation("TripDriver")
  attendedTrips         TransportTrip[]  @relation("TripAttendant")

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("staff_profiles")
}

/// School calendar entries (M00 §13) — working days live in SchoolConfig(OPERATING)
model CalendarEvent {
  id                String            @id @default(uuid())
  tenantId          String
  branchId          String?
  academicSessionId String?
  date              DateTime          @db.Date
  type              CalendarEventType
  title             String
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  academicSession   AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("calendar_events")
}

/// JSON configuration per domain — ONLY for domains with no natural entity (M00 §41 one source of truth)
model SchoolConfig {
  id            String       @id @default(uuid())
  tenantId      String
  domain        ConfigDomain
  data          Json
  updatedById   String?
  updatedByName String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@map("school_configs")
}


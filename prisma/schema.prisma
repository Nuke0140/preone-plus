  staffProfileId     String
  docType            StaffDocumentType
  documentNumber     String?
  fileUrl            String
  fileName           String?
  expiryDate         DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedByName     String?
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile       StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffProfileId])
  @@map("staff_documents")
}

/// Academic & vocational qualifications (e.g. ECCE, NTT, B.Ed)
model StaffQualification {
  id             String       @id @default(uuid())
  tenantId       String
  staffProfileId String
  degree         String
  institution    String
  fieldOfStudy   String?
  yearOfPassing  Int?
  isEcceCertified Boolean     @default(false)

model PurchaseRequestItem {
  id                String          @id @default(uuid())
  purchaseRequestId String
  itemId            String
  requestedQuantity Decimal         @db.Decimal(12, 4)
  estimatedUnitCost Decimal?        @db.Decimal(12, 2)
  approvedQuantity  Decimal?        @db.Decimal(12, 4)
  notes             String?

  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item              InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  branchId             String
  academicSessionId    String?
  vendorId             String
  purchaseRequestId    String?
  poNumber             String
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  currency             String              @default("INR")
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(12, 2)
  shippingAmount       Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal           Decimal             @default(0) @db.Decimal(12, 2)
  notes                String?
  terms                String?
  createdById          String
  createdByName        String
  approvedById         String?
  approvedByName       String?
  approvedAt           DateTime?
  cancelledById        String?
  cancelledByName      String?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicSession      AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  purchaseRequest      PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  invoices             Invoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String             @id @default(uuid())
  purchaseOrderId   String
  itemId            String
  quantity          Decimal            @db.Decimal(12, 4)
  unitPrice         Decimal            @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  taxRate           Decimal            @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal            @db.Decimal(12, 2)
  receivedQuantity  Decimal            @default(0) @db.Decimal(12, 4)
  pendingQuantity   Decimal            @db.Decimal(12, 4)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item              InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  goodsReceiptItems GoodsReceiptItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                 String             @id @default(uuid())
  tenantId           String
  branchId           String
  purchaseOrderId    String
  vendorId           String
  grnNumber          String
  receiptDate        DateTime           @default(now())
  receivedById       String
  receivedByName     String

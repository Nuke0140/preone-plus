model Curriculum {
  id                String                   @id @default(uuid())
  tenantId          String
  academicSessionId String?
  programId         String?
  programType       ProgramType?
  name              String
  description       String?
  framework         String                   @default("EYFS")
  version           Int                      @default(1)
  status            CurriculumStatus         @default(ACTIVE)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  academicSession   AcademicSession?         @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  program           Program?                 @relation(fields: [programId], references: [id], onDelete: SetNull)
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learningAreas     CurriculumLearningArea[]
  activities        ClassroomActivity[]

  @@index([tenantId, academicSessionId])
  @@index([tenantId, programId])
  @@map("curriculums")
}

model CurriculumLearningArea {
  id            String         @id @default(uuid())
  tenantId      String
  curriculumId  String
  name          String
  code          String?
  description   String?
  displayOrder  Int            @default(0)
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  curriculum    Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goals         LearningGoal[]

  @@index([tenantId, curriculumId])
  @@map("curriculum_learning_areas")
}

model LearningGoal {
  id                       String                 @id @default(uuid())
  tenantId                 String
  curriculumLearningAreaId String
  name                     String
  description              String?
  ageMinMonths             Int?
  ageMaxMonths             Int?
  displayOrder             Int                    @default(0)
  status                   String                 @default("ACTIVE")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  learningArea             CurriculumLearningArea @relation(fields: [curriculumLearningAreaId], references: [id], onDelete: Cascade)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities               ClassroomActivity[]
  observations             Observation[]
  progressRecords          StudentProgress[]

  @@index([tenantId, curriculumLearningAreaId])
  @@map("learning_goals")
}

model ClassroomActivity {
  id                String          @id @default(uuid())
  tenantId          String
  academicSessionId String
  classroomId       String
  curriculumId      String?
  learningGoalId    String?
  teacherId         String?
  title             String
  activityType      String?         @default("ACTIVITY")
  description       String?
  activityDate      DateTime
  startTime         String?
  endTime           String?
  durationMinutes   Int             @default(30)
  materials         String?
  instructions      String?
  expectedOutcome   String?
  actualOutcome     String?
  status            ActivityStatus  @default(PLANNED)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classroom         Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  curriculum        Curriculum?     @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  learningGoal      LearningGoal?   @relation(fields: [learningGoalId], references: [id], onDelete: SetNull)
  teacher           User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  observations      Observation[]
  materialRequests  MaterialRequest[]

  @@index([tenantId, academicSessionId, classroomId])
  @@index([activityDate])
  @@map("classroom_activities")
}

model StudentProgress {
  id                String          @id @default(uuid())
  tenantId          String
  academicSessionId String
  studentId         String
  learningGoalId    String
  stage             ProgressStage   @default(NOT_STARTED)
  notes             String?
  evidence          String?
  assessedBy        String?
  assessedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  assessedByUser    User?           @relation(fields: [assessedBy], references: [id], onDelete: SetNull)
  learningGoal      LearningGoal    @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicSessionId, studentId, learningGoalId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicSessionId])
  @@map("student_progress")
}

// ====================================================================
// INVENTORY & PROCUREMENT BOUNDED CONTEXT
// ====================================================================

enum ItemType {
  CONSUMABLE
  LEARNING_MATERIAL
  FOOD_SUPPLY
  HYGIENE_SUPPLY
  FIRST_AID
  MAINTENANCE
  STUDENT_SUPPLY
  EVENT_MATERIAL
  OTHER
}

enum LocationType {
  MAIN_STORE
  BRANCH_STORE
  CLASSROOM_STORE
  KITCHEN_STORE
  MEDICAL_ROOM
  ACTIVITY_ROOM
  OTHER
}

enum MovementType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRY
}

enum DestinationType {
  CLASSROOM
  ACTIVITY
  KITCHEN
  CLEANING
  OPERATIONS
  STAFF
  STUDENT
  OTHER
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_ISSUED
  FULFILLED
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  SUBMITTED
  FINALIZED
  CANCELLED
}

enum StockIssueStatus {
  COMPLETED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  EXPIRED
}

enum AdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPLIED
  REJECTED
}

enum InvoiceType {
  STUDENT_FEE
  VENDOR_BILL
}

model InventoryCategory {
  id               String               @id @default(uuid())
  tenantId         String
  name             String
  code             String
  description      String?
  parentCategoryId String?
  sortOrder        Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdById      String?
  updatedById      String?

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCategory   InventoryCategory?   @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    InventoryCategory[]  @relation("CategoryHierarchy")
  items            InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("inventory_categories")
}

model InventoryUnit {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  code           String
  symbol         String
  decimalAllowed Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("inventory_units")
}

model Vendor {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  code           String
  legalName      String?
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  gstin          String?
  pan            String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultItems   InventoryItem[] @relation("DefaultVendor")
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       Invoice[]
  payments       Payment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("vendors")
}

model InventoryLocation {
  id               String               @id @default(uuid())
  tenantId         String
  branchId         String
  name             String
  code             String
  locationType     LocationType         @default(MAIN_STORE)
  parentLocationId String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentLocation   InventoryLocation?   @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  subLocations     InventoryLocation[]  @relation("LocationHierarchy")
  stocks           InventoryStock[]
  movementsFrom    StockMovement[]      @relation("MovementFromLocation")
  movementsTo      StockMovement[]      @relation("MovementToLocation")
  issues           StockIssue[]
  receiptItems     GoodsReceiptItem[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("inventory_locations")
}

model InventoryItem {
  id                   String                @id @default(uuid())
  tenantId             String
  categoryId           String
  unitId               String
  defaultVendorId      String?
  sku                  String
  name                 String
  description          String?
  itemType             ItemType              @default(CONSUMABLE)
  trackStock           Boolean               @default(true)
  trackBatch           Boolean               @default(false)
  trackExpiry          Boolean               @default(false)
  trackSerial          Boolean               @default(false)
  isConsumable         Boolean               @default(true)
  isAsset              Boolean               @default(false)
  minimumStock         Decimal               @default(0) @db.Decimal(12, 4)
  reorderLevel         Decimal               @default(0) @db.Decimal(12, 4)
  maximumStock         Decimal?              @db.Decimal(12, 4)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdById          String?
  updatedById          String?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             InventoryCategory     @relation(fields: [categoryId], references: [id])
  unit                 InventoryUnit         @relation(fields: [unitId], references: [id])
  defaultVendor        Vendor?               @relation("DefaultVendor", fields: [defaultVendorId], references: [id], onDelete: SetNull)
  stocks               InventoryStock[]
  movements            StockMovement[]
  materialRequestItems MaterialRequestItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  stockIssueItems      StockIssueItem[]
  stockReturnItems     StockReturnItem[]
  stockAdjustmentItems StockAdjustmentItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@map("inventory_items")
}

model InventoryStock {
  id                String            @id @default(uuid())
  tenantId          String
  branchId          String
  locationId        String
  itemId            String
  batchNumber       String?
  expiryDate        DateTime?
  serialNumber      String?
  quantity          Decimal           @default(0) @db.Decimal(12, 4)
  reservedQuantity  Decimal           @default(0) @db.Decimal(12, 4)
  availableQuantity Decimal           @default(0) @db.Decimal(12, 4)
  unitCost          Decimal?          @db.Decimal(12, 2)
  averageCost       Decimal?          @db.Decimal(12, 2)
  lastMovementAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([locationId, itemId, batchNumber, serialNumber])
  @@index([tenantId, branchId, itemId])
  @@index([tenantId, itemId])
  @@index([tenantId, expiryDate])
  @@map("inventory_stocks")
}

model StockMovement {
  id                String             @id @default(uuid())
  tenantId          String
  branchId          String
  academicSessionId String?
  itemId            String
  locationId        String
  movementType      MovementType
  quantity          Decimal            @db.Decimal(12, 4)
  unitCost          Decimal?           @db.Decimal(12, 2)
  referenceType     String
  referenceId       String?
  fromLocationId    String?
  toLocationId      String?
  batchNumber       String?
  expiryDate        DateTime?
  reason            String?
  performedById     String?
  performedByName   String?
  requestId         String?
  metadata          Json?
  createdAt         DateTime           @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession?   @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  item              InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation      InventoryLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation        InventoryLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, itemId])
  @@index([tenantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model MaterialRequest {
  id                String                @id @default(uuid())
  tenantId          String
  branchId          String
  academicSessionId String?
  classroomId       String?
  activityId        String?
  requestNumber     String
  requestedById     String
  requestedByName   String
  requestedByRole   String?
  destinationType   DestinationType       @default(CLASSROOM)
  destinationId     String?
  requiredDate      DateTime
  priority          RequestPriority       @default(NORMAL)
  status            MaterialRequestStatus @default(PENDING)
  reason            String?
  notes             String?
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedByName    String?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession?      @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  classroom         Classroom?            @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  activity          ClassroomActivity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
